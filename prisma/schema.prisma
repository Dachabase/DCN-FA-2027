// Prisma schema for UI Freshers AI (Shared between Part A Web App & Part B Telegram Bot)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// FACULTY
// =========================================================

model Faculty {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments   Department[]
  users         User[]
  bots          Bot[]
  guides        Guide[]
  resources     Resource[]
  opportunities Opportunity[]
  faqs          FAQ[]
  questions     Question[]
}

// =========================================================
// BOT
// =========================================================

model Bot {
  id String @id @default(cuid())

  telegramBotId BigInt @unique
  username      String @unique
  name          String

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// DEPARTMENT
// =========================================================

model Department {
  id   String @id @default(cuid())
  name String

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  users         User[]
  guides        Guide[]
  resources     Resource[]
  opportunities Opportunity[]
  faqs          FAQ[]
  courses       DepartmentCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([facultyId, name])
}

// =========================================================
// COURSE & SHARED PACKAGE JOIN MODEL
// =========================================================

enum CourseStatus {
  COMPULSORY
  REQUIRED
  ELECTIVE
}

model Course {
  id               String       @id @default(cuid())
  code             String       @unique // e.g. "CSC 101", "MAT 111", "GES 107"
  title            String
  level            Int          @default(100) // Extensible to 200, 300, 400 later
  semester         String       // "1st" or "2nd"
  status           CourseStatus @default(COMPULSORY)
  units            Int
  isUniversityWide Boolean      @default(false) // True for GES/GST block

  departments      DepartmentCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepartmentCourse {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([departmentId, courseId])
}

// =========================================================
// REFERENCE RULES (CREDIT LIMITS & CGPA SCALE)
// =========================================================

model ReferenceRule {
  id          String   @id @default(cuid())
  category    String   // "CREDIT_LOAD" or "CGPA_SCALE"
  title       String
  key         String   @unique
  value       String   // JSON stringified rule details
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// USER (Telegram & Web Profile)
// =========================================================

model User {
  id         String @id @default(cuid())
  telegramId BigInt @unique

  firstName String?
  lastName  String?
  username  String?

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  level Int?

  onboardingStep String?

  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  totalPoints    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  memories      Memory[]
  quizAttempts  QuizAttempt[]
}

// =========================================================
// CONVERSATION
// =========================================================

model Conversation {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

// =========================================================
// MESSAGE
// =========================================================

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  createdAt DateTime @default(now())
}

enum MessageRole {
  USER
  ASSISTANT
}

// =========================================================
// MEMORY
// =========================================================

model Memory {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       String
  content    String
  importance Int   @default(1)
  confidence Float @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// CBT QUESTION BANK
// =========================================================

model Question {
  id           String   @id @default(cuid())
  courseCode   String   // e.g. "CSC101", "MAT111", "GST101", "GES107"
  courseTitle  String   // e.g. "Introduction to Computer Science"
  topic        String   // e.g. "Binary Arithmetic", "Calculus", "Logic"
  type         String   @default("MCQ") // "MCQ" or "TRUE_FALSE"
  questionText String
  options      String[] // ["A) Option 1", "B) Option 2", "C) Option 3", "D) Option 4"]
  correctAnswer String  // e.g. "A" or "True"
  explanation  String   // Detailed explanation

  facultyId    String?
  faculty      Faculty? @relation(fields: [facultyId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// =========================================================
// QUIZ ATTEMPTS & PROGRESS TRACKER
// =========================================================

model QuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseCode       String
  mode             String   // "PRACTICE", "EXAM", "REVISION"
  score            Float
  totalQuestions   Int
  correctCount     Int
  wrongCount       Int
  unansweredCount  Int
  timeSpentSeconds Int      @default(0)

  createdAt        DateTime @default(now())
}

// =========================================================
// PART A: RESOURCE
// =========================================================

model Resource {
  id          String   @id @default(cuid())
  type        String   // "pdf", "link", "handbook", "past_questions", "lecture_notes"
  title       String
  description String
  url         String
  category    String   // "Academic", "Administrative", "Library", "Tools"
  tags        String[] // ["100L", "CSC101", "Registration"]
  status      String   @default("PUBLISHED") // "PUBLISHED", "DRAFT", "ARCHIVED"

  facultyId   String?
  faculty     Faculty? @relation(fields: [facultyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Provenance metadata (Required for AI bot factual grounding)
  source       String   // e.g. "UI Academic Affairs / Faculty Handbook"
  verifiedDate DateTime @default(now())
  owner        String   // e.g. "UI Academic Secretariat"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// PART A: FACULTY GUIDE
// =========================================================

model Guide {
  id          String   @id @default(cuid())
  title       String
  summary     String
  content     String   // Markdown / Rich text content
  category    String   // "Course Registration", "Grading System", "Lecture Venues", "Exams & Rules", "Campus Life"
  status      String   @default("PUBLISHED")

  facultyId   String?
  faculty     Faculty? @relation(fields: [facultyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Provenance metadata
  source       String
  verifiedDate DateTime @default(now())
  owner        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// PART A: OPPORTUNITY
// =========================================================

model Opportunity {
  id           String    @id @default(cuid())
  title        String
  description  String
  organization String
  url          String
  deadline     DateTime?
  type         String    // "Scholarship", "Internship", "Hackathon", "Work-Study", "Mentorship"
  category     String    @default("General")
  tags         String[]
  status       String    @default("ACTIVE")

  facultyId    String?
  faculty      Faculty?  @relation(fields: [facultyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Provenance metadata
  source       String
  verifiedDate DateTime  @default(now())
  owner        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================================================
// PART A: FAQ
// =========================================================

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   // "Admissions & Clearance", "Fees & Payments", "Course Add/Drop", "Hostel & Housing", "Exams & Results"
  tags        String[]
  status      String   @default("PUBLISHED")

  facultyId   String?
  faculty     Faculty? @relation(fields: [facultyId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  // Provenance metadata
  source       String
  verifiedDate DateTime @default(now())
  owner        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}