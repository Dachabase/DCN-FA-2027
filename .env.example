# =========================================================================
# UI Freshers Companion / BlastExams - Environment Configuration Template
# =========================================================================
# Copy this file to .env and replace placeholders with real credentials.
# NEVER commit the real .env file or production secrets to source control.
# =========================================================================

# Database Connection (PostgreSQL 16 / AWS RDS / Aurora / Supabase / Neon)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=<require|no-verify>
# Obtain from your database host console (AWS RDS, Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/ui_freshers?sslmode=require"

# Application Server Port & Environment
# Set by container/hosting platform (Render automatically sets PORT) or local dev
PORT=3000
NODE_ENV="development"

# Canonical Public Web Application URL
# Canonical domain used for 301 redirects, OpenGraph metadata, and self-health pings
APP_URL="https://blastexams.app"

# CORS Configuration
# Comma-separated list of allowed origins permitted to make credentialed browser requests
CORS_ALLOWED_ORIGINS="https://blastexams.app,https://www.blastexams.app,http://localhost:3000,http://localhost:5173"

# Telegram Bot Integration
# Obtain from @BotFather on Telegram via /newbot or /token command
TELEGRAM_COMPUTING_BOT_TOKEN="0000000000:AAAAA_PLACEHOLDER_TELEGRAM_BOT_TOKEN"
# Note: TELEGRAM_BOT_TOKEN is also supported as a fallback alias for backward compatibility.
DEFAULT_TELEGRAM_BOT_USERNAME="UIDCNComputingFreshersBot"

# Google OAuth 2.0 (OpenID Connect / Sign-in)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID="000000000000-placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-placeholder_google_oauth_secret"

# Session JWT Secrets (Authentication & Token Rotation)
# Generate high-entropy 64-character random hex strings using: openssl rand -hex 32
JWT_SECRET="generate_a_64_char_cryptographically_secure_random_hex_secret_key"
JWT_REFRESH_SECRET="generate_a_different_64_char_cryptographically_secure_random_hex_secret"

# Google Gemini AI Key & Models (AI Study Assistant & Smart Prompts)
# Obtain your API key from Google AI Studio at https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyPlaceholderGeminiApiKeyForStudyAssistant"
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-2.5-flash"

# Academic Vault & Resources (Google Drive Link)
# Master Google Drive folder containing UI 100-Level lecture slides, textbooks, and past papers
GOOGLE_DRIVE_RESOURCES_URL="https://drive.google.com/drive/folders/your_google_drive_folder_id"

# Database Connection Pool & SSL Settings
# Maximum concurrent pooled database connections (tune based on RDS instance class / RAM)
DB_POOL_MAX=20
# Strict SSL CA certificate verification ("true" to enforce CA validation, "false" for self-signed/no-verify)
DB_SSL_STRICT="false"
