# =========================================================================
# UI Freshers Companion - Environment Configuration Template
# =========================================================================

# Database Connection (AWS RDS PostgreSQL 16 / Aurora Serverless v2)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@fa27.ct2ua4mes3jl.eu-north-1.rds.amazonaws.com:5432/ui_freshers?sslmode=require"

# Application Server Port
PORT=3000
NODE_ENV="development"

# Google OAuth 2.0 (OpenID Connect)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# JWT Secrets for Session Token & Refresh Token Pair
JWT_SECRET="generate-a-strong-random-secret-key-for-access-tokens"
JWT_REFRESH_SECRET="generate-a-strong-random-secret-key-for-refresh-tokens"

# AWS Configuration (When fetching credentials directly from AWS Secrets Manager)
AWS_REGION="eu-north-1"
AWS_SECRET_NAME="ui-freshers/production/rds-postgres-credentials"

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_SSL_STRICT="false"

# Telegram Bot Integration
TELEGRAM_COMPUTING_BOT_TOKEN="your-telegram-bot-token"
DEFAULT_TELEGRAM_BOT_USERNAME="UIDCNComputingFreshersBot"

# Google Gemini AI Key (For AI study assistant features)
GEMINI_API_KEY="your-gemini-api-key"
