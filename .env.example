# =========================================================================
# UI Freshers Companion - Environment Configuration Template
# =========================================================================

# Database Connection (PostgreSQL 16 / AWS RDS / Aurora)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/ui_freshers"

# Application Server Port & Environment
PORT=3000
NODE_ENV="development"

# CORS Configuration
# Comma-separated list of allowed origins for the web client (browser requests with credentials)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# Google OAuth 2.0 (OpenID Connect)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# JWT Secrets for Session Token & Refresh Token Pair
JWT_SECRET="generate-a-strong-random-secret-key-for-access-tokens"
JWT_REFRESH_SECRET="generate-a-strong-random-secret-key-for-refresh-tokens"

# AWS Configuration (When fetching credentials directly from AWS Secrets Manager)
AWS_REGION="eu-north-1"
AWS_SECRET_NAME="ui-freshers/production/rds-postgres-credentials"

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_SSL_STRICT="false"

# Telegram Bot Integration
# Canonical token environment variable:
TELEGRAM_COMPUTING_BOT_TOKEN="your-telegram-bot-token"
# Note: TELEGRAM_BOT_TOKEN is supported as a fallback alias for backward compatibility.
DEFAULT_TELEGRAM_BOT_USERNAME="UIDCNComputingFreshersBot"

# Google Gemini AI Key & Model (For AI study assistant features)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.7-flash"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash"

